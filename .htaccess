# Branch Admin pages
RewriteRule ^views/branch-admin/branch-admin-dashboard\.html$ views/security/branch-admin/security-branch-admin-dashboard.php [L,NC]
RewriteRule ^views/branch-admin/branch-admin-settings\.html$ views/security/branch-admin/security-branch-admin-settings.php [L,NC]
