# Assessment pages
RewriteRule ^views/assessment/assessment-dashboard\.html$ views/security/assessment/security-assessment-dashboard.php [L,NC]
RewriteRule ^views/assessment/assessment-loans-management\.html$ views/security/assessment/security-assessment-loans-management.php [L,NC]
